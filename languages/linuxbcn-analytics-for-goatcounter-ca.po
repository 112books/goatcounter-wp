msgid "GoatCounter Analytics"
msgstr "GoatCounter Analítiques"

msgid "Analytics"
msgstr "Analítiques"

msgid "Statistics"
msgstr "Estadístiques"

msgid "Settings"
msgstr "Configuració"

msgid "GoatCounter — Settings"
msgstr "GoatCounter — Configuració"

msgid "How to set up GoatCounter"
msgstr "Com configurar GoatCounter"

msgid "Create a free account at <a href=\"%s\" target=\"_blank\" rel=\"noopener\">goatcounter.com</a>."
msgstr "Crea un compte gratuït a <a href=\"%s\" target=\"_blank\" rel=\"noopener\">goatcounter.com</a>."

msgid "Your site code is the subdomain of your dashboard URL. Example: if your URL is mysite.goatcounter.com, your site code is mysite."
msgstr "El codi del lloc és el subdomini de la teva URL del tauler. Exemple: si la URL és mysite.goatcounter.com, el codi és mysite."

msgid "Get your API token at <strong>Settings → API</strong> in your GoatCounter dashboard (<a href=\"%s\" target=\"_blank\" rel=\"noopener\">%s</a>)."
msgstr "Obtén el token de l'API a <strong>Configuració → API</strong> del tauler de GoatCounter (<a href=\"%s\" target=\"_blank\" rel=\"noopener\">%s</a>)."

msgid "Paste both values below and save."
msgstr "Enganxa els dos valors aquí sota i desa."

msgid "Site code"
msgstr "Codi del lloc"

msgid "The subdomain of your GoatCounter dashboard (e.g. mysite from mysite.goatcounter.com)."
msgstr "El subdomini del tauler de GoatCounter (p. ex. mysite de mysite.goatcounter.com)."

msgid "API token"
msgstr "Token de l'API"

msgid "Found at Settings → API in your GoatCounter dashboard."
msgstr "El trobaràs a Configuració → API del tauler de GoatCounter."

msgid "Save settings"
msgstr "Desa la configuració"

msgid "⚙️ Configure your GoatCounter site code and API token in <a href=\"%s\">Settings</a>."
msgstr "⚙️ Configura el codi del lloc i el token de l'API de GoatCounter a <a href=\"%s\">Configuració</a>."

msgid "Today"
msgstr "Avui"

msgid "Last 7 days"
msgstr "Darrers 7 dies"

msgid "Last 30 days"
msgstr "Darrers 30 dies"

msgid "Visits"
msgstr "Visites"

msgid "Unique visitors"
msgstr "Visitants únics"

msgid "New visitors"
msgstr "Visitants nous"

msgid "What does this mean?"
msgstr "Què vol dir això?"

msgid "Top pages"
msgstr "Pàgines principals"

msgid "Page"
msgstr "Pàgina"

msgid "Unique"
msgstr "Únics"

msgid "Referrers"
msgstr "Orígens"

msgid "Source"
msgstr "Origen"

msgid "Countries"
msgstr "Països"

msgid "No data yet."
msgstr "Encara no hi ha dades."

msgid "No referrers yet."
msgstr "Encara no hi ha orígens."

msgid "(direct)"
msgstr "(directe)"

msgid "No visits recorded yet. Make sure the tracking script is active and the site has received traffic."
msgstr "Encara no s'han registrat visites. Assegura't que l'script de seguiment és actiu i que el lloc ha rebut trànsit."

msgid "today"
msgstr "avui"

msgid "in the last 7 days"
msgstr "els darrers 7 dies"

msgid "in the last 30 days"
msgstr "els darrers 30 dies"

msgid "in this period"
msgstr "en aquest període"

msgid "direct traffic"
msgstr "trànsit directe"

msgid "Your site received <strong>%1$s visits</strong> from <strong>%2$s unique visitors</strong> %3$s."
msgstr "El teu lloc ha rebut <strong>%1$s visites</strong> de <strong>%2$s visitants únics</strong> %3$s."

msgid "%d%% of visits are returning visitors — a good sign of loyal readership."
msgstr "El %d%% de les visites són visitants recurrents — un bon signe de fidelitat."

msgid "The most visited page is <strong>%s</strong>."
msgstr "La pàgina més visitada és <strong>%s</strong>."

msgid "Most traffic comes from <strong>%s</strong>."
msgstr "La majoria del trànsit prové de <strong>%s</strong>."
